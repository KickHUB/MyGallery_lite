# ComfyUI paths
SOURCE=/absolute/path/to/ComfyUI/output
# Optional: folder name for sorted files (default: Sorted_by_Date)
# DEST_FOLDER_NAME=Sorted_by_Date
# Lite policy: DEST is derived automatically as SOURCE/DEST_FOLDER_NAME
# DEST=/absolute/path/to/ComfyUI/output/Sorted_by_Date

# Tag index storage
INDEX=/path/to/MyGallery/data/indexes
FFMPEG_PATH=tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=tools/ffmpeg/bin/ffprobe.exe
FFPLAY_PATH=tools/ffmpeg/bin/ffplay.exe
EXIFTOOL_PATH=tools/exiftool/exiftool.exe

# Danbooru tag dictionary update
# 현재 공개 소스 예시:
BOORU_DICT_SOURCE_PRESET=hf:newtextdoc1111/danbooru-tag-csv@main:danbooru_tags.csv
BOORU_DICT_CACHE_DIR=data/booru_cache
BOORU_DICT_SKIP_IF_SAME_SHA256=1
# BOORU_DICT_ALLOW_CUSTOM_URL=0
# BOORU_DICT_CUSTOM_URL=

# Draft detection & storage
# - PNG 이름에 'draft'가 포함되어 있으면 Draft로 간주 (대소문자 무관)
# - Draft는 {DEST}/{DRAFTS_FOLDER_NAME}/YYYY-MM-DD/ 구조로 이동·정리
DRAFTS_FOLDER_NAME=Drafts


# Web server
PORT=5000
ALLOWED_IPS=192.168.0.1,192.168.0.2
SECRET_KEY=change-me-to-long-random
DEBUG_MODE=0

# Optional: Hugging Face cache path
# HF_HOME=/path/to/huggingface/cache
